# Copy to .env (scripts/setup-host.sh does this for you and fills DOCKER_GID + POSTGRES_PASSWORD).
# .env is git-ignored. Never commit real secrets.

# Password for the SonarQube PostgreSQL database
POSTGRES_PASSWORD=change-me

# Group id of /var/run/docker.sock on the host: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Host ports
JENKINS_PORT=8080
SONARQUBE_PORT=9000

# Pinned tool versions (bump deliberately, then rebuild: docker compose build --no-cache jenkins)
SONARQUBE_TAG=26.10.0.133078-community
TRIVY_VERSION=0.76.1
SONAR_SCANNER_VERSION=8.1.0.6389
